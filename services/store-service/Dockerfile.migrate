FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o ecommerce-store-service-migrate ./migrations/migrate.go

FROM alpine:latest

WORKDIR /app

COPY --from=builder /app/ecommerce-store-service-migrate .
COPY --from=builder /app/migrations ./migrations

CMD ["./ecommerce-store-service-migrate"]